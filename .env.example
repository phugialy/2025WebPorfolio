# GitHub project sync
GITHUB_TOKEN=
GITHUB_USERNAME=phugialy

# Social media manager agent. Reuses CRON_SECRET above for its cron routes
# and OPENROUTER_API_KEY above for its LLM adapter, so neither is
# duplicated here. See docs/research/social-media-manager-agent.md.
OPENROUTER_SOCIAL_MODEL=
# Zernio (social platform API/MCP layer). ZERNIO_API_KEY is now read by
# app/social-agent-adapters/zernio-platform.ts -- when set, the social
# pipeline cron route (app/api/cron/social-pipeline/route.ts) wires up the
# real Zernio-backed Platform adapter instead of the logging-only stub
# (app/social-agent-adapters/platform.ts). Leave unset to keep running
# against the stub (safe no-op, matches this project's existing
# if-not-configured-return-null convention). ZERNIO_WEBHOOK_SECRET is only
# needed once webhook registration (Phase 3/5) happens -- not yet consumed
# by any route.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# MCP server for Hippo-Assist (app/api/mcp/social/route.ts) -- a separate
# conversational control-plane project connecting as an MCP client. Its own
# distinct secret: deliberately NOT the same value as CRON_SECRET (that
# authorizes this project's own GitHub Actions workflows) or an admin
# session. Bearer token (or x-api-key header) checked by
# app/api/mcp/social/auth.ts. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# and set the SAME value here and on Hippo-Assist's side.
SOCIAL_MCP_API_KEY=
